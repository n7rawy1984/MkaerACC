# Public browser configuration only. These values are placeholders.
# The current P1 application still uses the localStorage demo adapter and
# does not read these variables; Supabase frontend wiring belongs to P6.
VITE_APP_DATA_MODE=local-demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER add database passwords, Supabase access tokens, secret/service-role
# keys, or other privileged credentials to VITE_* variables. Vite embeds
# every VITE_* value in the browser bundle.
