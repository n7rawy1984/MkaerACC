# Non-secret server configuration for the existing application.
# Supabase supplies the project URL and server credentials in its function runtime.
# Do not copy service credentials into Vite or commit a populated secrets file.
PLATFORM_APP_ORIGIN=https://maker-eosin.vercel.app
# Optional exact HTTPS origins allowed to call delivery; callbacks still use PLATFORM_APP_ORIGIN.
PLATFORM_INVITATION_ADDITIONAL_ORIGINS=[]
